# Copy to .env and adjust. .env is git-ignored.
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler

# Data-node roles (spine AD-1). The service name never implies the role. A failover is
# the promote step plus flipping these two lines (story 5 failover script).
# Every app gets all nodes and picks the writable one.
PG_PRIMARY=postgres-1
REDIS_MASTER=redis-1
# Streaming-replication login, created on the primary's first start
PG_REPL_USER=replicator
PG_REPL_PASSWORD=replicator

# Host ports of the data nodes (IDE runs, psql, redis-cli)
POSTGRES_1_PORT=5432
POSTGRES_2_PORT=5433
REDIS_1_PORT=6379
REDIS_2_PORT=6380
API_PORT=8080
BATCH_PORT=8081

HEARTBEAT_CRON="0 */5 * * * *"

# Timezone of the app containers (log timestamps, cron)
TZ=Asia/Ho_Chi_Minh
