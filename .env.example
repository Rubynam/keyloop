# Copy to .env and adjust. .env is git-ignored.
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler

POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
BATCH_PORT=8081
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4318

HEARTBEAT_CRON="0 */5 * * * *"

# Timezone of the app containers (log timestamps, cron)
TZ=Asia/Ho_Chi_Minh

# Share of traces kept (0.0–1.0). 1.0 for dev; lower it for load tests and prod
TRACING_SAMPLING_PROBABILITY=1.0
