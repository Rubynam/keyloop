{
  "_doc": "Spec06 §6. Budgets per request name (the 'name' of a scenario request). A profile's block replaces 'default'. p50/p95/p99 in ms; maxFailRatio = share of responses that did not match the expected output.",
  "default": {
    "global": { "maxFailRatio": 0.01, "max5xx": 0 },
    "endpoints": {}
  },
  "profiles": {
    "smoke": {
      "global": { "maxFailRatio": 0, "max5xx": 0 },
      "endpoints": {
        "/api/v1/ping":       { "p95": 100, "maxFailRatio": 0 },
        "/actuator/health":   { "p95": 300, "maxFailRatio": 0 }
      }
    },
    "load": {
      "global": { "maxFailRatio": 0.01, "max5xx": 0 },
      "endpoints": {
        "/api/v1/availability [hot]":            { "p50": 30,  "p95": 150, "p99": 400,  "minRequests": 500, "maxFailRatio": 0.001 },
        "/api/v1/availability [cold]":           { "p95": 600, "p99": 1500, "maxFailRatio": 0.01 },
        "/api/v1/availability [invalid]":        { "p95": 100 },
        "/api/v1/dealerships":            { "p95": 150 },
        "/api/v1/service-types":          { "p95": 150 },
        "/api/v1/appointments":                 { "p95": 400, "p99": 1000, "minRequests": 100, "maxFailRatio": 0.01 },
        "/api/v1/appointments/{id}":             { "p95": 150 },
        "/api/v1/appointments/{id}/cancel":    { "p95": 400 },
        "/api/v1/appointments/{id}/reschedule":{ "p95": 500 }
      }
    },
    "stress": {
      "_note": "Find the knee, do not gate on latency: only 'no 5xx, mostly expected outputs'. Read the p95 curve in reports/stress.html.",
      "global": { "maxFailRatio": 0.05, "max5xx": 0 },
      "endpoints": {}
    },
    "spike": {
      "global": { "maxFailRatio": 0.02, "max5xx": 0 },
      "endpoints": {
        "/api/v1/availability [hot]": { "p99": 1500 },
        "/api/v1/appointments":      { "p99": 2000 }
      }
    },
    "abuse": {
      "global": { "maxFailRatio": 0, "max5xx": 0 },
      "endpoints": { "/api/v1/availability [abuse]": { "p95": 200, "minRequests": 200 } }
    },
    "race": {
      "global": { "maxFailRatio": 0, "max5xx": 0 },
      "endpoints": {}
    },
    "ramp": {
      "_note": "Ramp 0 -> 100 RPS (RampShape) on the endpoints the API serves today, while loadtest/simulator writes bookings.",
      "global": { "maxFailRatio": 0.01, "max5xx": 0 },
      "endpoints": {
        "/api/v1/availability [hot]":     { "p50": 30,  "p95": 150, "p99": 400,  "minRequests": 5000, "maxFailRatio": 0.001 },
        "/api/v1/availability [cold]":    { "p95": 600, "p99": 1500, "maxFailRatio": 0.01 },
        "/api/v1/availability [invalid]": { "p95": 100, "maxFailRatio": 0 },
        "/api/v1/availability [unknown]": { "p95": 150, "maxFailRatio": 0 },
        "/api/v1/ping":                   { "p95": 100, "maxFailRatio": 0 }
      }
    },
    "book-ramp": {
      "_note": "Ramp 0 -> 100 RPS (RampShape) on POST /api/v1/appointments (Spec07), ~70% writes, written by the API itself (no simulator). 409/422 are expected outputs, not failures.",
      "global": { "maxFailRatio": 0.01, "max5xx": 0 },
      "endpoints": {
        "/api/v1/appointments":                { "p50": 50, "p95": 400, "p99": 1000, "minRequests": 2000, "maxFailRatio": 0.01 },
        "/api/v1/appointments [contended]":    { "p95": 600, "p99": 1500, "maxFailRatio": 0.01 },
        "/api/v1/appointments [replay]":       { "p95": 150, "maxFailRatio": 0.01 },
        "/api/v1/appointments [conflict]":     { "p95": 400, "maxFailRatio": 0.01 },
        "/api/v1/appointments [invalid]":      { "p95": 100, "maxFailRatio": 0 },
        "/api/v1/appointments [unprocessable]":{ "p95": 300, "maxFailRatio": 0 },
        "/api/v1/availability [hot]":          { "p50": 30, "p95": 150, "p99": 400, "maxFailRatio": 0.001 }
      }
    },
    "book-burst": {
      "_note": "Waves of N customers on ONE slot at the same instant, 150 requests/s (BurstShape). 409/422 are expected outputs. 'waves': every wave must end with its perWave count (expected/81-book-burst.json); a wave with too many 201s always fails.",
      "global": { "maxFailRatio": 0.01, "max5xx": 0 },
      "waves": { "minExactRatio": 1.0 },
      "endpoints": {
        "/api/v1/appointments [burst cap1]":     { "p50": 150, "p95": 800, "p99": 1500, "maxFailRatio": 0.01 },
        "/api/v1/appointments [burst cap2]":     { "p50": 150, "p95": 800, "p99": 1500, "maxFailRatio": 0.01 },
        "/api/v1/appointments [burst cap6]":     { "p50": 150, "p95": 800, "p99": 1500, "maxFailRatio": 0.01 },
        "/api/v1/appointments [burst cap7]":     { "p50": 150, "p95": 800, "p99": 1500, "minRequests": 1000, "maxFailRatio": 0.01 },
        "/api/v1/appointments [burst same-car]": { "p50": 150, "p95": 800, "p99": 1500, "maxFailRatio": 0.01 }
      }
    }
  }
}
