{
  "suite": "30-booking",
  "goal": "The write path (DLD §5). Under concurrent load a booking either succeeds with a real (bay, technician) pair or is refused with a clear 4xx — never a 5xx, never a silent double booking. Every refusal reason in DLD §11 has one case.",
  "precondition": "seeding/seed.sh. Booking load fills Q7 slots over time, so 409 on BK-01 is an expected outcome. Day ranges per case do not overlap (BK-01 2–120, BK-02 121–240, BK-03 241–360, 40-lifecycle 361–600), so one case never steals another case’s slot.",
  "expectedFile": "expected/30-booking.json",
  "_doc": "Input requests. Locust loads this file, binds {{tokens}}, sends each request, then checks it against expectedFile.",
  "cases": [
    {
      "id": "BK-01",
      "goal": "Normal booking at the hub: a random standard car, oil change, random 15-min slot 2–120 days ahead. Expected 201 with the assigned bay + technician, 409 when that slot is already taken by load, or 422 when the same vehicle is already booked then (Spec07 D2).",
      "verifies": ["ROADMAP §1.3", "DLD §5", "NFR-03"],
      "weight": 20,
      "bind": {
        "v": "pool:standardCars",
        "key": "uuid",
        "start": {
          "slot": {
            "tz": "Asia/Ho_Chi_Minh",
            "days": [2, 120],
            "open": "08:00",
            "lastStart": "16:00",
            "stepMinutes": 15
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/appointments",
        "name": "/api/v1/appointments",
        "headers": {"Idempotency-Key": "{{key}}"},
        "body": {
          "customerId": "{{v.customerId}}",
          "vehicleId": "{{v.vehicleId}}",
          "dealershipId": "{{ref.dealerships.Q7}}",
          "serviceTypeId": "{{ref.serviceTypes.OIL_CHANGE}}",
          "startTime": "{{start}}"
        }
      }
    },
    {
      "id": "BK-02",
      "goal": "Idempotent retry: the client times out and sends the SAME request with the SAME Idempotency-Key → the same appointment comes back (201, same id), no second row.",
      "verifies": ["DLD §5 idempotency_key", "Spec03 idempotency_key UNIQUE"],
      "weight": 4,
      "bind": {
        "v": "pool:standardCars",
        "key": "uuid",
        "start": {
          "slot": {
            "tz": "Asia/Ho_Chi_Minh",
            "days": [121, 240],
            "open": "08:00",
            "lastStart": "16:00",
            "stepMinutes": 15
          }
        }
      },
      "steps": [
        {
          "id": "first",
          "request": {
            "method": "POST",
            "path": "/api/v1/appointments",
            "name": "/api/v1/appointments",
            "headers": {"Idempotency-Key": "{{key}}"},
            "body": {
              "customerId": "{{v.customerId}}",
              "vehicleId": "{{v.vehicleId}}",
              "dealershipId": "{{ref.dealerships.Q7}}",
              "serviceTypeId": "{{ref.serviceTypes.TYRE_ROTATION}}",
              "startTime": "{{start}}"
            }
          },
          "save": {"first": "id"}
        },
        {
          "id": "replay",
          "request": {
            "method": "POST",
            "path": "/api/v1/appointments",
            "name": "/api/v1/appointments [replay]",
            "headers": {"Idempotency-Key": "{{key}}"},
            "body": {
              "customerId": "{{v.customerId}}",
              "vehicleId": "{{v.vehicleId}}",
              "dealershipId": "{{ref.dealerships.Q7}}",
              "serviceTypeId": "{{ref.serviceTypes.TYRE_ROTATION}}",
              "startTime": "{{start}}"
            }
          }
        }
      ]
    },
    {
      "id": "BK-03",
      "goal": "Same vehicle, same time, NEW key → 422 (Spec07 D2): one car cannot be in two bays at once (DB-03), even though the hub has free bays and technicians.",
      "verifies": ["Spec03 DB-03 ex_appointments_vehicle"],
      "weight": 3,
      "bind": {
        "v": "pool:standardCars",
        "k1": "uuid",
        "k2": "uuid",
        "start": {
          "slot": {
            "tz": "Asia/Ho_Chi_Minh",
            "days": [241, 360],
            "open": "08:00",
            "lastStart": "16:00",
            "stepMinutes": 15
          }
        }
      },
      "steps": [
        {
          "id": "first",
          "request": {
            "method": "POST",
            "path": "/api/v1/appointments",
            "name": "/api/v1/appointments",
            "headers": {"Idempotency-Key": "{{k1}}"},
            "body": {
              "customerId": "{{v.customerId}}",
              "vehicleId": "{{v.vehicleId}}",
              "dealershipId": "{{ref.dealerships.Q7}}",
              "serviceTypeId": "{{ref.serviceTypes.OIL_CHANGE}}",
              "startTime": "{{start}}"
            }
          }
        },
        {
          "id": "overlap",
          "request": {
            "method": "POST",
            "path": "/api/v1/appointments",
            "name": "/api/v1/appointments [conflict]",
            "headers": {"Idempotency-Key": "{{k2}}"},
            "body": {
              "customerId": "{{v.customerId}}",
              "vehicleId": "{{v.vehicleId}}",
              "dealershipId": "{{ref.dealerships.Q7}}",
              "serviceTypeId": "{{ref.serviceTypes.TYRE_ROTATION}}",
              "startTime": "{{start}}"
            }
          }
        }
      ]
    },
    {
      "id": "BK-04",
      "goal": "Start in the past → 400 (validator, no DB write).",
      "verifies": ["DLD §1 BookingValidator"],
      "bind": {
        "v": "pool:standardCars",
        "key": "uuid",
        "start": {"at": {"tz": "Asia/Ho_Chi_Minh", "days": -1, "time": "09:00"}}
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/appointments",
        "name": "/api/v1/appointments [invalid]",
        "headers": {"Idempotency-Key": "{{key}}"},
        "body": {
          "customerId": "{{v.customerId}}",
          "vehicleId": "{{v.vehicleId}}",
          "dealershipId": "{{ref.dealerships.Q7}}",
          "serviceTypeId": "{{ref.serviceTypes.OIL_CHANGE}}",
          "startTime": "{{start}}"
        }
      }
    },
    {
      "id": "BK-05",
      "goal": "Outside opening hours: 20:00 local at the hub (open 08:00–17:00) → 422 (Spec07 §5.1: valid shape, business rule fails).",
      "verifies": ["DLD §1 BookingValidator", "Spec03 §3.4 business hours in app"],
      "bind": {
        "v": "pool:standardCars",
        "key": "uuid",
        "start": {"at": {"tz": "Asia/Ho_Chi_Minh", "days": 5, "time": "20:00"}}
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/appointments",
        "name": "/api/v1/appointments [invalid]",
        "headers": {"Idempotency-Key": "{{key}}"},
        "body": {
          "customerId": "{{v.customerId}}",
          "vehicleId": "{{v.vehicleId}}",
          "dealershipId": "{{ref.dealerships.Q7}}",
          "serviceTypeId": "{{ref.serviceTypes.OIL_CHANGE}}",
          "startTime": "{{start}}"
        }
      }
    },
    {
      "id": "BK-06",
      "goal": "Starts inside the hours but ENDS after closing: 16:30 + 60 min at the hub (closes 17:00) → 422 (Spec07 §5.1). The whole window must fit.",
      "verifies": ["ROADMAP §1.3 'entire service duration'"],
      "bind": {
        "v": "pool:standardCars",
        "key": "uuid",
        "start": {"at": {"tz": "Asia/Ho_Chi_Minh", "days": 5, "time": "16:30"}}
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/appointments",
        "name": "/api/v1/appointments [invalid]",
        "headers": {"Idempotency-Key": "{{key}}"},
        "body": {
          "customerId": "{{v.customerId}}",
          "vehicleId": "{{v.vehicleId}}",
          "dealershipId": "{{ref.dealerships.Q7}}",
          "serviceTypeId": "{{ref.serviceTypes.OIL_CHANGE}}",
          "startTime": "{{start}}"
        }
      }
    },
    {
      "id": "BK-07",
      "goal": "Vehicle not owned by the customer (customer with no vehicle + someone else's hybrid) → 400.",
      "verifies": ["DLD §11 'vehicle not owned by customer'"],
      "bind": {"key": "uuid", "start": {"at": {"tz": "Asia/Ho_Chi_Minh", "days": 6, "time": "09:00"}}},
      "request": {
        "method": "POST",
        "path": "/api/v1/appointments",
        "name": "/api/v1/appointments [invalid]",
        "headers": {"Idempotency-Key": "{{key}}"},
        "body": {
          "customerId": "{{ref.customers.NO_VEHICLE}}",
          "vehicleId": "{{ref.vehicles.HYBRID.vehicleId}}",
          "dealershipId": "{{ref.dealerships.Q7}}",
          "serviceTypeId": "{{ref.serviceTypes.OIL_CHANGE}}",
          "startTime": "{{start}}"
        }
      }
    },
    {
      "id": "BK-08",
      "goal": "Missing startTime / empty body fields → 400 from bean validation, never a 500 NullPointerException.",
      "verifies": ["Spec01 API-08"],
      "bind": {"v": "pool:standardCars", "key": "uuid"},
      "request": {
        "method": "POST",
        "path": "/api/v1/appointments",
        "name": "/api/v1/appointments [invalid]",
        "headers": {"Idempotency-Key": "{{key}}"},
        "body": {
          "customerId": "{{v.customerId}}",
          "vehicleId": "{{v.vehicleId}}",
          "dealershipId": "{{ref.dealerships.Q7}}"
        }
      }
    },
    {
      "id": "BK-09",
      "goal": "Unknown dealership → 404.",
      "verifies": ["DLD §11"],
      "bind": {"v": "pool:standardCars", "key": "uuid", "start": {"at": {"tz": "UTC", "days": 6, "time": "09:00"}}},
      "request": {
        "method": "POST",
        "path": "/api/v1/appointments",
        "name": "/api/v1/appointments [not-found]",
        "headers": {"Idempotency-Key": "{{key}}"},
        "body": {
          "customerId": "{{v.customerId}}",
          "vehicleId": "{{v.vehicleId}}",
          "dealershipId": "00000000-0000-7000-8000-000000000000",
          "serviceTypeId": "{{ref.serviceTypes.OIL_CHANGE}}",
          "startTime": "{{start}}"
        }
      }
    },
    {
      "id": "BK-10",
      "goal": "Hydrogen car at the hub → 422: no bay or technician there takes the vehicle type, at ANY time (different from 409 'busy now').",
      "verifies": ["DLD §11 E9", "ROADMAP D2"],
      "bind": {"key": "uuid", "start": {"at": {"tz": "Asia/Ho_Chi_Minh", "days": 6, "time": "09:00"}}},
      "request": {
        "method": "POST",
        "path": "/api/v1/appointments",
        "name": "/api/v1/appointments [unprocessable]",
        "headers": {"Idempotency-Key": "{{key}}"},
        "body": {
          "customerId": "{{ref.vehicles.HYDROGEN.customerId}}",
          "vehicleId": "{{ref.vehicles.HYDROGEN.vehicleId}}",
          "dealershipId": "{{ref.dealerships.Q7}}",
          "serviceTypeId": "{{ref.serviceTypes.OIL_CHANGE}}",
          "startTime": "{{start}}"
        }
      }
    },
    {
      "id": "BK-11",
      "goal": "Electric truck at the hub → 422: a technician is certified for it, but the hub has no heavy high-voltage bay. Both resources are needed.",
      "verifies": ["DLD §11 E9", "Spec03 §3.2 heavy HV bay"],
      "bind": {"key": "uuid", "start": {"at": {"tz": "Asia/Ho_Chi_Minh", "days": 6, "time": "09:00"}}},
      "request": {
        "method": "POST",
        "path": "/api/v1/appointments",
        "name": "/api/v1/appointments [unprocessable]",
        "headers": {"Idempotency-Key": "{{key}}"},
        "body": {
          "customerId": "{{ref.vehicles.ELECTRIC_TRUCK.customerId}}",
          "vehicleId": "{{ref.vehicles.ELECTRIC_TRUCK.vehicleId}}",
          "dealershipId": "{{ref.dealerships.Q7}}",
          "serviceTypeId": "{{ref.serviceTypes.TRUCK_AXLE_SERVICE}}",
          "startTime": "{{start}}"
        }
      }
    },
    {
      "id": "BK-12",
      "goal": "Service that no technician anywhere can do (hydrogen fuel-cell service, gasoline car) → 422, not an endless 409.",
      "verifies": ["Spec03 §6.5 'service type no technician can do'"],
      "bind": {
        "v": "pool:standardCars",
        "key": "uuid",
        "start": {"at": {"tz": "Asia/Ho_Chi_Minh", "days": 6, "time": "09:00"}}
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/appointments",
        "name": "/api/v1/appointments [unprocessable]",
        "headers": {"Idempotency-Key": "{{key}}"},
        "body": {
          "customerId": "{{v.customerId}}",
          "vehicleId": "{{v.vehicleId}}",
          "dealershipId": "{{ref.dealerships.Q7}}",
          "serviceTypeId": "{{ref.serviceTypes.HYDROGEN_FUEL_CELL_SERVICE}}",
          "startTime": "{{start}}"
        }
      }
    }
  ]
}
