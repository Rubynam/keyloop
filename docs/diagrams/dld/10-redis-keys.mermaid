flowchart LR
    subgraph KEYS["Redis keys"]
        K1["avail:ver:{dealerId}:{date}<br/>INT · bumped by relay · TTL 2 days"]
        K2["avail:{dealerId}:{date}:v{ver}:{serviceTypeId}:{vehicleTypeId}<br/>JSON slots · TTL 30–60s + jitter"]
        K3["avail:lock:{dealerId}:{date}:{serviceTypeId}:{vehicleTypeId}<br/>single-flight · PX 2s"]
        K4["ratelimit:{clientId}<br/>token bucket"]
    end
    K1 -->|"selects current"| K2
    K3 -.->|"guards rebuild of"| K2
