flowchart LR
    APPT["appointments"]
    APPT --> C1["EXCLUDE USING gist<br/>(technician_id WITH =,<br/>tstzrange(start_time, end_time, '[)') WITH &&)<br/>WHERE status <> 'CANCELLED'"]
    APPT --> C2["EXCLUDE USING gist<br/>(service_bay_id WITH =,<br/>tstzrange(...) WITH &&)<br/>WHERE status <> 'CANCELLED'"]
    APPT --> C3["EXCLUDE USING gist<br/>(vehicle_id WITH =,<br/>tstzrange(...) WITH &&)<br/>WHERE status <> 'CANCELLED'"]
    APPT --> C4["CHECK end_time > start_time"]
    APPT --> C5["FK (service_bay_id, vehicle_type_id)<br/>→ service_bay_vehicle_types<br/>(bay takes this vehicle type)"]
    APPT --> C6["FK (technician_id, vehicle_type_id)<br/>→ technician_vehicle_types<br/>(technician certified)"]
    APPT --> C7["FK (technician_id, service_type_id)<br/>→ technician_skills<br/>(technician skilled)"]
    APPT --> C8["FK (vehicle_id, vehicle_type_id)<br/>→ vehicles(id, vehicle_type_id)"]
    APPT --> C9["FK (service_bay_id, dealership_id),<br/>(technician_id, dealership_id)<br/>(same dealership)"]
    VEH["vehicles"] --> C10["FK (car_info_id, vehicle_type_id)<br/>→ car_info(id, vehicle_type_id)<br/>(type copy always matches the model)"]
    APPT --> I1["INDEX (dealership_id, start_time)"]
    SBVT["service_bay_vehicle_types"] --> I3["INDEX (vehicle_type_id)"]
    OUT["outbox_events"] --> I2["PARTIAL INDEX (next_attempt_at)<br/>WHERE processed_at IS NULL AND failed_at IS NULL"]
    OUT --> C11["CHECK processed_at IS NULL OR failed_at IS NULL"]
    ALL["every table"] --> U1["id UUID DEFAULT uuidv7()"]
