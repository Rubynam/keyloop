flowchart TD
    S(["Input: dealer, serviceType, vehicleType, date"]) --> A["duration = serviceType.duration_minutes"]
    A --> B["Load business hours (dealer timezone → UTC)"]
    B --> C["Load active bays of dealer<br/>WHERE vehicle_type = vehicleType (pool)"]
    B --> D["Load active technicians with skill = serviceType<br/>AND certified for vehicleType"]
    C --> E["Load non-cancelled appointments overlapping the day<br/>for those bays / technicians"]
    D --> E
    E --> F["Generate candidate start times<br/>(slot step TBD, e.g. 15 min)"]
    F --> G{"For each start:<br/>window = [start, start + duration)"}
    G --> H{"Window inside business hours?"}
    H -- "no" --> SKIP["Skip"]
    H -- "yes" --> I{"Exists free bay<br/>AND free qualified technician<br/>for the whole window?"}
    I -- "no" --> SKIP
    I -- "yes" --> OK["Add slot"]
    OK --> G
    SKIP --> G
    G -- "done" --> R(["Return list of free slots"])
