              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const date = pm.collectionVariables.get(\"futureDate\");",
                  "pm.test(\"200, UTC\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.timezone).to.eql(\"UTC\");",
                  "});",
                  "pm.test(\"first slot 00:00, last slot 23:00-24:00\", () => {",
                  "    const slots = body.days[0].slots;",
                  "    pm.expect(slots[0].start).to.eql(`${date}T00:00:00Z`);",
                  "    const last = slots[slots.length - 1];",
                  "    pm.expect(last.start).to.eql(`${date}T23:00:00Z`);",
                  "    const next = new Date(Date.parse(date) + 24 * 60 * 60 * 1000).toISOString().slice(0, 10);",
                  "    pm.expect(last.end).to.eql(`${next}T00:00:00Z`);",
                  "});"
                ]
              }
            }
          ]
        },
