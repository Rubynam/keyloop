{
  "info": {
    "name": "keyloop-scheduler",
    "description": "Manual / newman checks for the Scheduler API against docker compose + seed data (spec-read-availability). See postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Rolling dates so the \"future\" requests keep working after the seed anchor day.",
          "// Seed-pinned requests (back-to-back, kiosk, DST) use fixed dates instead.",
          "const day = 24 * 60 * 60 * 1000;",
          "const iso = (offsetDays) => new Date(Date.now() + offsetDays * day).toISOString().slice(0, 10);",
          "pm.collectionVariables.set(\"futureDate\", iso(3));",
          "pm.collectionVariables.set(\"futureDatePlus1\", iso(4));",
          "pm.collectionVariables.set(\"futureDatePlus2\", iso(5));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"X-Request-Id echoed\", () => {",
          "    pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.be.a(\"string\").and.not.empty;",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "futureDate",
      "value": ""
    },
    {
      "key": "futureDatePlus1",
      "value": ""
    },
    {
      "key": "futureDatePlus2",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ping"
              ]
            },
            "description": "Smoke check: the API is up behind nginx."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 ok\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Availability",
      "item": [
        {
          "name": "Availability - happy path (hub, oil change, gasoline car)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/availability?dealershipId={{hubDealershipId}}&serviceTypeId={{oilChangeServiceTypeId}}&vehicleTypeId={{gasolineCarVehicleTypeId}}&from={{futureDate}}&to={{futureDatePlus1}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "availability"
              ],
              "query": [
                {
                  "key": "dealershipId",
                  "value": "{{hubDealershipId}}"
                },
                {
                  "key": "serviceTypeId",
                  "value": "{{oilChangeServiceTypeId}}"
                },
                {
                  "key": "vehicleTypeId",
                  "value": "{{gasolineCarVehicleTypeId}}"
                },
                {
                  "key": "from",
                  "value": "{{futureDate}}"
                },
                {
                  "key": "to",
                  "value": "{{futureDatePlus1}}"
                }
              ]
            },
            "description": "Main hub (Asia/Ho_Chi_Minh, 08:00-17:00), OIL_CHANGE 60 min, GASOLINE_CAR. Rolling dates (today + 3/4 days)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"200 with the requested triple\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.dealershipId).to.eql(pm.environment.get(\"hubDealershipId\"));",
                  "    pm.expect(body.serviceTypeId).to.eql(pm.environment.get(\"oilChangeServiceTypeId\"));",
                  "    pm.expect(body.vehicleTypeId).to.eql(pm.environment.get(\"gasolineCarVehicleTypeId\"));",
                  "    pm.expect(body.timezone).to.eql(\"Asia/Ho_Chi_Minh\");",
                  "    pm.expect(body.durationMinutes).to.eql(60);",
                  "});",
                  "pm.test(\"every date in range is listed\", () => {",
                  "    pm.expect(body.days.map(d => d.date)).to.eql([pm.collectionVariables.get(\"futureDate\"), pm.collectionVariables.get(\"futureDatePlus1\")]);",
                  "});",
                  "pm.test(\"slots: 15-min starts, +07:00, 60 min, inside 08:00-17:00\", () => {",
                  "    const all = body.days.flatMap(d => d.slots);",
                  "    pm.expect(all.length).to.be.above(0);",
                  "    all.forEach(s => {",
                  "        pm.expect(s.start).to.match(/T\\d{2}:(00|15|30|45):00\\+07:00$/);",
                  "        pm.expect(s.end).to.match(/\\+07:00$/);",
                  "        pm.expect(Date.parse(s.end) - Date.parse(s.start)).to.eql(60 * 60 * 1000);",
                  "        const hhmm = s.start.slice(11, 16);",
                  "        pm.expect(hhmm >= \"08:00\" && hhmm <= \"16:00\", hhmm).to.be.true;",
                  "    });",
                  "});",
                  "pm.test(\"no bay or technician ids exposed\", () => {",
                  "    pm.expect(pm.response.text()).to.not.match(/bay|technician/i);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Availability - back-to-back (Riverside, 2026-11-03)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/availability?dealershipId={{riversideDealershipId}}&serviceTypeId={{oilChangeServiceTypeId}}&vehicleTypeId={{gasolineCarVehicleTypeId}}&from=2026-11-03&to=2026-11-03",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "availability"
              ],
              "query": [
                {
                  "key": "dealershipId",
                  "value": "{{riversideDealershipId}}"
                },
                {
                  "key": "serviceTypeId",
                  "value": "{{oilChangeServiceTypeId}}"
                },
                {
                  "key": "vehicleTypeId",
                  "value": "{{gasolineCarVehicleTypeId}}"
                },
                {
                  "key": "from",
                  "value": "2026-11-03"
                },
                {
                  "key": "to",
                  "value": "2026-11-03"
                }
              ]
            },
            "description": "Seed-pinned: one fitting bay and one qualified technician, booked 08:00-09:00. Half-open windows make 09:00 free. Slot checks are skipped once the date has passed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const day = (body.days || [])[0] || { slots: [] };",
                  "pm.test(\"200, Asia/Ho_Chi_Minh, 2026-11-03 listed\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.timezone).to.eql(\"Asia/Ho_Chi_Minh\");",
                  "    pm.expect(body.days).to.have.lengthOf(1);",
                  "    pm.expect(day.date).to.eql(\"2026-11-03\");",
                  "});",
                  "// Seed: the only bay + technician pair is busy 08:00-09:00 local on 2026-11-03.",
                  "// Before 08:00 local every check below is meaningful; after that, slots are past and dropped.",
                  "const live = Date.now() < Date.parse(\"2026-11-03T08:00:00+07:00\");",
                  "(live ? pm.test : pm.test.skip)(\"09:00 offered right after the 08:00-09:00 job, 08:00-08:45 not\", () => {",
                  "    const starts = day.slots.map(s => s.start);",
                  "    pm.expect(starts).to.include(\"2026-11-03T09:00:00+07:00\");",
                  "    [\"08:00\", \"08:15\", \"08:30\", \"08:45\"].forEach(t =>",
                  "        pm.expect(starts).to.not.include(`2026-11-03T${t}:00+07:00`));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Availability - fully booked kiosk (2026-11-04)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/availability?dealershipId={{kioskDealershipId}}&serviceTypeId={{tyreRotationServiceTypeId}}&vehicleTypeId={{gasolineCarVehicleTypeId}}&from=2026-11-04&to=2026-11-04",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "availability"
              ],
              "query": [
                {
                  "key": "dealershipId",
                  "value": "{{kioskDealershipId}}"
                },
                {
                  "key": "serviceTypeId",
                  "value": "{{tyreRotationServiceTypeId}}"
                },
                {
                  "key": "vehicleTypeId",
                  "value": "{{gasolineCarVehicleTypeId}}"
                },
                {
                  "key": "from",
                  "value": "2026-11-04"
                },
                {
                  "key": "to",
                  "value": "2026-11-04"
                }
              ]
            },
            "description": "Express kiosk open 09:00-10:00; seed fills the hour (09:00-09:30, 09:30-09:55, 09:59-10:00), so a 30-min job never fits. The no-slot check is skipped once the date has passed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const day = (body.days || [])[0] || { slots: [] };",
                  "pm.test(\"200, Asia/Singapore, 2026-11-04 listed\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.timezone).to.eql(\"Asia/Singapore\");",
                  "    pm.expect(body.days).to.have.lengthOf(1);",
                  "    pm.expect(day.date).to.eql(\"2026-11-04\");",
                  "});",
                  "// Once the kiosk has opened, slots would be empty anyway (past), so the check proves nothing",
                  "const live = Date.now() < Date.parse(\"2026-11-04T09:00:00+08:00\");",
                  "(live ? pm.test : pm.test.skip)(\"no slots: the seed fills the only opening hour\", () => {",
                  "    pm.expect(day.slots).to.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Availability - DST end (New York, 2026-10-31..11-02)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/availability?dealershipId={{newYorkDealershipId}}&serviceTypeId={{oilChangeServiceTypeId}}&vehicleTypeId={{gasolineCarVehicleTypeId}}&from=2026-10-31&to=2026-11-02",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "availability"
              ],
              "query": [
                {
                  "key": "dealershipId",
                  "value": "{{newYorkDealershipId}}"
                },
                {
                  "key": "serviceTypeId",
                  "value": "{{oilChangeServiceTypeId}}"
                },
                {
                  "key": "vehicleTypeId",
                  "value": "{{gasolineCarVehicleTypeId}}"
                },
                {
                  "key": "from",
                  "value": "2026-10-31"
                },
                {
                  "key": "to",
                  "value": "2026-11-02"
                }
              ]
            },
            "description": "US DST ends 2026-11-01 02:00. Business hours stay 07:00-19:00 local; the UTC offset in the slots changes. Per-date checks are skipped once that date's last slot has passed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const days = body.days || [];",
                  "pm.test(\"200, America/New_York, three dates\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.timezone).to.eql(\"America/New_York\");",
                  "    pm.expect(days.map(d => d.date)).to.eql([\"2026-10-31\", \"2026-11-01\", \"2026-11-02\"]);",
                  "});",
                  "// Per date: checked only while its last 60-min slot (18:00 local) is still ahead, so a",
                  "// passed date cannot make the checks pass on an empty list.",
                  "[",
                  "    { date: \"2026-10-31\", offset: \"-04:00\" },",
                  "    { date: \"2026-11-01\", offset: \"-05:00\" },",
                  "    { date: \"2026-11-02\", offset: \"-05:00\" },",
                  "].forEach(({ date, offset }) => {",
                  "    const day = days.find(d => d.date === date) || { slots: [] };",
                  "    const live = Date.now() < Date.parse(`${date}T18:00:00${offset}`);",
                  "    (live ? pm.test : pm.test.skip)(`${date}: slots at ${offset} on the 07:00-18:00 wall clock`, () => {",
                  "        pm.expect(day.slots).to.not.be.empty;",
                  "        day.slots.forEach(s => {",
                  "            pm.expect(s.start.endsWith(offset), s.start).to.be.true;",
                  "            const hhmm = s.start.slice(11, 16);",
                  "            pm.expect(hhmm >= \"07:00\" && hhmm <= \"18:00\", hhmm).to.be.true;",
                  "            pm.expect(hhmm).to.match(/:(00|15|30|45)$/);",
                  "        });",
                  "        pm.expect(day.slots[day.slots.length - 1].start).to.eql(`${date}T18:00:00${offset}`);",
                  "    });",
                  "});",
                  "const nov2 = days.find(d => d.date === \"2026-11-02\") || { slots: [] };",
                  "(Date.now() < Date.parse(\"2026-11-02T07:00:00-05:00\") ? pm.test : pm.test.skip)(",
                  "    \"2026-11-02 opens at 07:00 local (-05:00)\", () => {",
                  "        pm.expect(nov2.slots[0].start).to.eql(\"2026-11-02T07:00:00-05:00\");",
                  "    });"
                ]
              }
            }
          ]
        },
